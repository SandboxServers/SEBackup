<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RestoreView"
             Foreground="White">

    <Grid Margin="8">

        <!-- ============================================================ -->
        <!-- Step 1: Select Instance + Restore Point                       -->
        <!-- ============================================================ -->
        <Border x:Name="RestoreStep1Panel" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="20" Visibility="Visible">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Step header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#5B9BD5" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock Text="1" Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Select Instance and Restore Point"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Instance selector -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Instance:"
                               Foreground="#B0B0CC" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RestoreInstanceCombo" Width="280"/>
                </StackPanel>

                <!-- Restore points heading -->
                <TextBlock Grid.Row="2" Text="Available Restore Points"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#B0B0CC" Margin="0,0,0,8"/>

                <!-- Restore point list -->
                <ListView x:Name="RestorePointList"
                          Grid.Row="3"
                          Background="#363654"
                          BorderBrush="#4A4A6A"
                          Margin="0,0,0,16">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Timestamp" Width="180"
                                            DisplayMemberBinding="{Binding Timestamp}"/>
                            <GridViewColumn Header="Type" Width="100"
                                            DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="Size" Width="100"
                                            DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Header="Chain" Width="200"
                                            DisplayMemberBinding="{Binding ChainInfo}"/>
                            <GridViewColumn Header="Manifest" Width="200"
                                            DisplayMemberBinding="{Binding ManifestFile}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Navigation -->
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="RestoreStep1NextButton"
                            Content="Next"
                            Background="#5B9BD5"
                            IsEnabled="False"
                            Padding="24,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Step 2: Review and Confirm                                    -->
        <!-- ============================================================ -->
        <Border x:Name="RestoreStep2Panel" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="20" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Step header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#5B9BD5" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock Text="2" Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Review Restore Summary"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Summary panel -->
                <Border Grid.Row="1" Background="#363654" CornerRadius="6"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Restore Details"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Instance:" Grid.Row="0" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="RestoreSummaryInstance" Grid.Row="0" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <TextBlock Text="Restore Point:" Grid.Row="1" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="RestoreSummaryTimestamp" Grid.Row="1" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="13" Margin="0,0,0,6"/>

                            <TextBlock Text="Backup Type:" Grid.Row="2" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="RestoreSummaryType" Grid.Row="2" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="13" Margin="0,0,0,6"/>

                            <TextBlock Text="Archive Size:" Grid.Row="3" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="RestoreSummarySize" Grid.Row="3" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="13" Margin="0,0,0,6"/>

                            <TextBlock Text="Chain Length:" Grid.Row="4" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="RestoreSummaryChain" Grid.Row="4" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="13" Margin="0,0,0,6"/>

                            <TextBlock Text="Target Path:" Grid.Row="5" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="RestoreSummaryTarget" Grid.Row="5" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Safety acknowledgment -->
                <Border Grid.Row="2" Background="#44FF6B6B" CornerRadius="6"
                        Padding="16" Margin="0,0,0,16">
                    <CheckBox x:Name="RestoreAcknowledgeCheckBox"
                              Foreground="White" FontSize="13">
                        <TextBlock TextWrapping="Wrap" Foreground="White">
                            I understand the server will be stopped during the restore process,
                            and a safety backup of the current state will be created first.
                        </TextBlock>
                    </CheckBox>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="RestoreStep2BackButton"
                            Content="Back"
                            Background="#3A3A5C"
                            Padding="24,8" Margin="0,0,8,0"/>
                    <Button x:Name="RestoreStep2RestoreButton"
                            Content="Restore"
                            Background="#FF6B6B"
                            IsEnabled="False"
                            Padding="24,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Step 3: Progress                                              -->
        <!-- ============================================================ -->
        <Border x:Name="RestoreStep3Panel" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="20" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Step header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#FFD93D" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock Text="3" Foreground="#1E1E2E"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Restoring..."
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress bar -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RestoreProgressLabel"
                                   Grid.Column="0"
                                   Text="Initializing restore..."
                                   Foreground="#B0B0CC" FontSize="12"/>
                        <TextBlock x:Name="RestoreProgressPercent"
                                   Grid.Column="1"
                                   Text="0%"
                                   Foreground="#B0B0CC" FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Grid>
                    <ProgressBar x:Name="RestoreProgressBar"
                                 Height="10" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>

                <!-- Step checklist -->
                <Border Grid.Row="2" Background="#363654" CornerRadius="6" Padding="20">
                    <StackPanel x:Name="RestoreChecklist">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="RestoreCheck1Icon"
                                       Text="&#x23FA;" Foreground="#808099"
                                       FontSize="14" Width="24"/>
                            <TextBlock x:Name="RestoreCheck1Text"
                                       Text="Verifying backup chain..."
                                       Foreground="#B0B0CC" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="RestoreCheck2Icon"
                                       Text="&#x23FA;" Foreground="#808099"
                                       FontSize="14" Width="24"/>
                            <TextBlock x:Name="RestoreCheck2Text"
                                       Text="Creating safety backup..."
                                       Foreground="#B0B0CC" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="RestoreCheck3Icon"
                                       Text="&#x23FA;" Foreground="#808099"
                                       FontSize="14" Width="24"/>
                            <TextBlock x:Name="RestoreCheck3Text"
                                       Text="Stopping server..."
                                       Foreground="#B0B0CC" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="RestoreCheck4Icon"
                                       Text="&#x23FA;" Foreground="#808099"
                                       FontSize="14" Width="24"/>
                            <TextBlock x:Name="RestoreCheck4Text"
                                       Text="Extracting files..."
                                       Foreground="#B0B0CC" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="RestoreCheck5Icon"
                                       Text="&#x23FA;" Foreground="#808099"
                                       FontSize="14" Width="24"/>
                            <TextBlock x:Name="RestoreCheck5Text"
                                       Text="Deploying restored files..."
                                       Foreground="#B0B0CC" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock x:Name="RestoreCheck6Icon"
                                       Text="&#x23FA;" Foreground="#808099"
                                       FontSize="14" Width="24"/>
                            <TextBlock x:Name="RestoreCheck6Text"
                                       Text="Starting server..."
                                       Foreground="#B0B0CC" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Step 4: Result (Success or Failure)                           -->
        <!-- ============================================================ -->
        <Border x:Name="RestoreStep4Panel" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="20" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Step header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border x:Name="RestoreResultIconBorder"
                            Background="#6BCB77" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock x:Name="RestoreResultIcon"
                                   Text="4" Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="RestoreResultTitle"
                               Text="Restore Complete"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Result summary -->
                <Border Grid.Row="1" Background="#363654" CornerRadius="6"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="RestoreResultMessage"
                                   Text=""
                                   Foreground="White" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="Restore Summary"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#B0B0CC" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Duration:" Grid.Row="0" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RestoreResultDuration" Grid.Row="0" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="12" Margin="0,0,0,4"/>

                            <TextBlock Text="Files Restored:" Grid.Row="1" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RestoreResultFiles" Grid.Row="1" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="12" Margin="0,0,0,4"/>

                            <TextBlock Text="Safety Backup:" Grid.Row="2" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RestoreResultSafety" Grid.Row="2" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <TextBlock Text="Server Status:" Grid.Row="3" Grid.Column="0"
                                       Foreground="#B0B0CC" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RestoreResultServer" Grid.Row="3" Grid.Column="1"
                                       Text="--" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="RestoreUndoButton"
                            Content="Undo Restore"
                            Background="#FF6B6B"
                            Padding="24,8" Margin="0,0,8,0"/>
                    <Button x:Name="RestoreNewButton"
                            Content="New Restore"
                            Background="#3A3A5C"
                            Padding="24,8"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
