<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SettingsView"
             Foreground="White">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Main Settings Area (TreeView + Form)                          -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Settings Navigation TreeView -->
            <Border Grid.Column="0" Background="#2D2D44" CornerRadius="8"
                    BorderBrush="#4A4A6A" BorderThickness="1"
                    Padding="8" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Configuration"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White" Margin="8,4,0,12"/>

                    <TreeView x:Name="SettingsTreeView" Background="Transparent"
                              BorderThickness="0">
                        <TreeViewItem Header="General" x:Name="SettingsTreeGeneral"
                                      IsSelected="True" IsExpanded="True"/>
                        <TreeViewItem Header="Storage" x:Name="SettingsTreeStorage"/>
                        <TreeViewItem Header="Schedule" x:Name="SettingsTreeSchedule"/>
                        <TreeViewItem Header="Retention" x:Name="SettingsTreeRetention"/>
                        <TreeViewItem Header="Compression" x:Name="SettingsTreeCompression"/>
                        <TreeViewItem Header="Network" x:Name="SettingsTreeNetwork"/>
                        <TreeViewItem Header="Notifications" x:Name="SettingsTreeNotifications"/>
                    </TreeView>
                </StackPanel>
            </Border>

            <!-- Right: Settings Form Panel -->
            <Border Grid.Column="1" Background="#2D2D44" CornerRadius="8"
                    BorderBrush="#4A4A6A" BorderThickness="1"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>

                        <!-- ======================================== -->
                        <!-- General Settings Panel                    -->
                        <!-- ======================================== -->
                        <StackPanel x:Name="SettingsPanelGeneral" Visibility="Visible">
                            <TextBlock Text="General Settings"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <TextBlock Text="These are the core settings for the SEBackup system. Most settings are configured in the sections to the left."
                                       Foreground="#B0B0CC" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Config File:"
                                           Grid.Row="0" Grid.Column="0"
                                           Foreground="#B0B0CC" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SettingsConfigPath"
                                           Grid.Row="0" Grid.Column="1"
                                           Text="Loading..."
                                           Foreground="White" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>

                                <TextBlock Text="Project Root:"
                                           Grid.Row="1" Grid.Column="0"
                                           Foreground="#B0B0CC" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SettingsProjectRoot"
                                           Grid.Row="1" Grid.Column="1"
                                           Text="Loading..."
                                           Foreground="White" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                            </Grid>
                        </StackPanel>

                        <!-- ======================================== -->
                        <!-- Storage Settings Panel                    -->
                        <!-- ======================================== -->
                        <StackPanel x:Name="SettingsPanelStorage" Visibility="Collapsed">
                            <TextBlock Text="Storage Settings"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <Label Content="C&amp;C Backup Root"/>
                            <TextBox x:Name="SettingsStorageCCRoot"
                                     Margin="0,0,0,16"/>

                            <Label Content="NAS Backup Path (UNC or mapped drive, leave empty to disable)"/>
                            <TextBox x:Name="SettingsStorageNASPath"
                                     Margin="0,0,0,16"/>

                            <Label Content="VSS Mount Base"/>
                            <TextBox x:Name="SettingsStorageVSSMount"
                                     Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- ======================================== -->
                        <!-- Schedule Settings Panel                   -->
                        <!-- ======================================== -->
                        <StackPanel x:Name="SettingsPanelSchedule" Visibility="Collapsed">
                            <TextBlock Text="Schedule Settings"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <CheckBox x:Name="SettingsScheduleEnabled"
                                      Content="Enable automatic backups"
                                      Margin="0,0,0,16"/>

                            <Label Content="Backup Interval (hours)"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsScheduleInterval"
                                        Grid.Column="0" Minimum="1" Maximum="48"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsScheduleIntervalLabel"
                                           Grid.Column="1" Text="6"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Label Content="Full Backup Interval (hours)"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsScheduleFullInterval"
                                        Grid.Column="0" Minimum="24" Maximum="720"
                                        TickFrequency="24" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsScheduleFullIntervalLabel"
                                           Grid.Column="1" Text="168"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Label Content="Max Incremental Chain Length"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsScheduleMaxChain"
                                        Grid.Column="0" Minimum="4" Maximum="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsScheduleMaxChainLabel"
                                           Grid.Column="1" Text="48"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Label Content="Start Time (HH:mm)"/>
                            <TextBox x:Name="SettingsScheduleStartTime"
                                     Width="100" HorizontalAlignment="Left"
                                     Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- ======================================== -->
                        <!-- Retention Settings Panel                  -->
                        <!-- ======================================== -->
                        <StackPanel x:Name="SettingsPanelRetention" Visibility="Collapsed">
                            <TextBlock Text="Retention Settings"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <Label Content="C&amp;C Full Backup Sets to Retain"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsRetentionCCCount"
                                        Grid.Column="0" Minimum="1" Maximum="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsRetentionCCCountLabel"
                                           Grid.Column="1" Text="2"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Label Content="NAS Retention Days (0 = keep forever)"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsRetentionNASDays"
                                        Grid.Column="0" Minimum="0" Maximum="365"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsRetentionNASDaysLabel"
                                           Grid.Column="1" Text="90"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- ======================================== -->
                        <!-- Compression Settings Panel                -->
                        <!-- ======================================== -->
                        <StackPanel x:Name="SettingsPanelCompression" Visibility="Collapsed">
                            <TextBlock Text="Compression Settings"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <Label Content="Compression Engine"/>
                            <ComboBox x:Name="SettingsCompressionEngine"
                                      Width="200" HorizontalAlignment="Left"
                                      Margin="0,0,0,16">
                                <ComboBoxItem Content="auto" IsSelected="True"/>
                                <ComboBoxItem Content="7zip"/>
                                <ComboBoxItem Content="dotnet"/>
                            </ComboBox>

                            <Label Content="7-Zip Compression Level (1=fastest, 9=best)"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsCompressionLevel"
                                        Grid.Column="0" Minimum="1" Maximum="9"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsCompressionLevelLabel"
                                           Grid.Column="1" Text="5"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- ======================================== -->
                        <!-- Network Settings Panel                    -->
                        <!-- ======================================== -->
                        <StackPanel x:Name="SettingsPanelNetwork" Visibility="Collapsed">
                            <TextBlock Text="Network Settings"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <Label Content="Max Bandwidth (Mbps, 0 = unlimited)"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsNetworkBandwidth"
                                        Grid.Column="0" Minimum="0" Maximum="1000"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsNetworkBandwidthLabel"
                                           Grid.Column="1" Text="100"
                                           Foreground="White" FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Label Content="Robocopy Inter-Packet Gap (ms, 0 = disabled)"/>
                            <TextBox x:Name="SettingsNetworkIPG"
                                     Width="100" HorizontalAlignment="Left"
                                     Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- ======================================== -->
                        <!-- Notifications Settings Panel              -->
                        <!-- ======================================== -->
                        <StackPanel x:Name="SettingsPanelNotifications" Visibility="Collapsed">
                            <TextBlock Text="Notification Settings"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <CheckBox x:Name="SettingsNotifyEnabled"
                                      Content="Enable notifications"
                                      Margin="0,0,0,16"/>

                            <Label Content="Discord Webhook URL"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SettingsNotifyWebhook" Grid.Column="0"
                                         Margin="0,0,8,0"/>
                                <Button x:Name="SettingsNotifyTestButton"
                                        Grid.Column="1"
                                        Content="Test"
                                        Background="#3A3A5C"
                                        Padding="16,6"/>
                            </Grid>

                            <TextBlock Text="Send Notifications On:"
                                       Foreground="#B0B0CC" FontSize="12"
                                       Margin="0,0,0,8"/>
                            <CheckBox x:Name="SettingsNotifyOnSuccess"
                                      Content="Successful backups"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="SettingsNotifyOnFailure"
                                      Content="Failed backups"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="SettingsNotifyOnWarning"
                                      Content="Warnings (e.g., load delays)"
                                      Margin="0,0,0,16"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- Bottom: Node Management                                       -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="16" MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header + Add Node button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Node Management"
                               Grid.Column="0"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="SettingsSaveButton"
                            Grid.Column="1"
                            Content="Save Settings"
                            Background="#6BCB77"
                            Margin="0,0,8,0"
                            Padding="16,6"/>
                    <Button x:Name="SettingsAddNodeButton"
                            Grid.Column="2"
                            Content="Add Node"
                            Background="#5B9BD5"
                            Padding="16,6"/>
                </Grid>

                <!-- Node DataGrid -->
                <DataGrid x:Name="SettingsNodeGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}"
                                            Width="200"/>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}"
                                            Width="180"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}"
                                            Width="100"/>
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Test"
                                                Tag="{Binding Name}"
                                                Background="#3A3A5C"
                                                Padding="10,4"
                                                FontSize="11"
                                                Margin="0,0,4,0"/>
                                        <Button Content="Edit"
                                                Tag="{Binding Name}"
                                                Background="#3A3A5C"
                                                Padding="10,4"
                                                FontSize="11"
                                                Margin="0,0,4,0"/>
                                        <Button Content="Remove"
                                                Tag="{Binding Name}"
                                                Background="#663333"
                                                Padding="10,4"
                                                FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
