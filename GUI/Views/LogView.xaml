<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="LogView"
             Foreground="White">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Filter Bar                                                    -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="12" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Level filter -->
                <TextBlock Text="Level:" Foreground="#B0B0CC" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="LogLevelFilter" Width="100"
                          Margin="0,0,16,0" VerticalAlignment="Center">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="DEBUG"/>
                    <ComboBoxItem Content="INFO"/>
                    <ComboBoxItem Content="WARN"/>
                    <ComboBoxItem Content="ERROR"/>
                </ComboBox>

                <!-- Instance filter -->
                <TextBlock Text="Instance:" Foreground="#B0B0CC" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="LogInstanceFilter" Width="160"
                          Margin="0,0,16,0" VerticalAlignment="Center">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                </ComboBox>

                <!-- Date picker -->
                <TextBlock Text="Date:" Foreground="#B0B0CC" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="LogDateFilter"
                            Background="#3A3A5C"
                            Foreground="White"
                            BorderBrush="#4A4A6A"
                            Width="140"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"/>

                <!-- Search text -->
                <TextBlock Text="Search:" Foreground="#B0B0CC" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="LogSearchText" Width="200"
                         Margin="0,0,16,0" VerticalAlignment="Center"/>

                <!-- Refresh button -->
                <Button x:Name="LogRefreshButton"
                        Content="Refresh"
                        Background="#3A3A5C"
                        Padding="12,6"
                        FontSize="12"
                        VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Log Entries DataGrid                                          -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="2" Margin="0,0,0,12">
            <DataGrid x:Name="LogEntriesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Extended"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}"
                                        Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0B0CC"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Level" Binding="{Binding Level}"
                                        Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                                        <Setter Property="Foreground" Value="#808099"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                                        <Setter Property="Foreground" Value="#5B9BD5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                        <Setter Property="Foreground" Value="#FFD93D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                        <Setter Property="Foreground" Value="#FF6B6B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Context" Binding="{Binding Context}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0B0CC"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Message" Binding="{Binding Message}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================================================ -->
        <!-- Bottom: Export + Count + Auto-scroll                          -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="#2D2D44" CornerRadius="8"
                BorderBrush="#4A4A6A" BorderThickness="1"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="LogExportButton"
                        Grid.Column="0"
                        Content="Export to File"
                        Background="#3A3A5C"
                        Padding="12,6"
                        FontSize="12"
                        Margin="0,0,16,0"/>

                <CheckBox x:Name="LogAutoScrollToggle"
                          Grid.Column="1"
                          Content="Auto-scroll to bottom"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>

                <!-- Spacer -->
                <Border Grid.Column="2"/>

                <TextBlock x:Name="LogEntryCount"
                           Grid.Column="3"
                           Text="0 entries"
                           Foreground="#B0B0CC" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
